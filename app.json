{
  "expo": {
    "name": "Family Tree",
    "slug": "family-tree",
    "version": "1.2.1",
    "scheme": "family-tree",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF5E6"
    },
    "locales": {
      "pl": "./assets/info-plist-strings/pl.json",
      "en": "./assets/info-plist-strings/en.json",
      "de": "./assets/info-plist-strings/de.json",
      "nl": "./assets/info-plist-strings/nl.json",
      "no": "./assets/info-plist-strings/no.json",
      "sv": "./assets/info-plist-strings/sv.json",
      "da": "./assets/info-plist-strings/da.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mateuszbialowas.FamilyTree",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "owner": "mateuszbialowas",
    "extra": {
      "eas": {
        "projectId": "fa7d8a97-29fa-46f9-a3da-69a3549740d6"
      }
        }
  }
}
