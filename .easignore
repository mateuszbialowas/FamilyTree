# .easignore — files NOT uploaded to EAS Build.
# Syntax identical to .gitignore. EAS uploads the working dir as a tarball;
# without this file the upload is ~200 MB. With it, ~10 MB.
#
# Rule of thumb: keep app source + assets + RN config files. Everything else
# (native build outputs regenerated by `expo prebuild`, marketing assets,
# docs site, E2E tests) is dead weight at build time.

# === Native build outputs (regenerated by `expo prebuild` in EAS cloud) ===
ios/
android/

# === Marketing assets (not bundled into the app binary) ===
# Source screenshots from Maestro + framed mockups + final App Store images.
appstore-screenshots/
appstore-marketing/
screenshots/

# === E2E tests (not needed by the app build) ===
.maestro/

# === Docs site (independent VitePress project) ===
docs/

# === Local-only / generator scripts ===
# Keep this — these scripts aren't imported by the app and run only on dev
# machines. If a script is ever required at build time, move it elsewhere.
scripts/

# === IDE / OS ===
.vscode/
.idea/
.DS_Store

# === Dev artifacts that aren't covered by .gitignore in some setups ===
*.log
.expo/
dist/

# === Git internals (EAS doesn't need them) ===
.git/
.github/

# === CLAUDE / docs in repo root ===
CLAUDE.md
README.md
